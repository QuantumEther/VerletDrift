      <div class="canvas-resolution-control">
        <span>GPU Res</span>
        <input type="range" id="gpuResolutionScale" min="0.25" max="2.0" value="1.0" step="0.05">
        <span class="canvas-resolution-value" id="gpuResolutionScaleValue">1.0</span>
      </div>
      <!-- Stacked canvas container: gpuCanvas (world) + simCanvas (HUD overlay) + debugOverlay (DOM) -->
      <div class="canvas-container">
        <!-- WebGPU world-space canvas (below HUD) -->
        <canvas id="gpuCanvas" width="1600" height="1200"></canvas>
        <!-- Canvas 2D HUD overlay (above GPU canvas, transparent background) -->
        <canvas id="simCanvas" width="1600" height="1200"></canvas>
        <!-- DOM debug overlay (z-index 2, screen-space debug panels) -->
