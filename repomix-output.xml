          <div id="dbg-status"></div>
          <div id="dbg-fault-banner" class="dbg-fault-banner nominal">NOMINAL</div>
          <div id="dbg-telemetry-panel">
            <div class="dbg-panel-header">=== TELEMETRY ===</div>
